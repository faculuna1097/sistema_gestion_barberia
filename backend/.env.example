PORT=3001

# Credenciales de la base de datos (obtener desde Supabase → Settings → Database → Session Pooler)
DB_HOST=aws-0-[REGION].pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.[PROJECT-REF]
DB_PASSWORD=[TU-PASSWORD]

SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=[la service_role key]

JWT_SECRET=[un-secreto]
TENANT_ID=your-tenant-uuid-here

GOOGLE_CLIENT_ID=[TU-GOOGLE-CLIENT-ID]
GOOGLE_CLIENT_SECRET=[TU-GOOGLE-CLIENT-SECRET]
GOOGLE_CALENDAR_EMAIL=[TU-GOOGLE-CALENDAR-EMAIL]
GOOGLE_REFRESH_TOKEN=[TU-GOOGLE-REFRESH-TOKEN]

# Envío de mails transaccionales — Resend (API HTTP, sin SMTP). Las GOOGLE_* de arriba
# son solo para Google Calendar, no para el mail.
RESEND_API_KEY=re_[TU-API-KEY]
MAIL_FROM=BarberManager <turnos@send.barbermanager.app>

# Opcional, solo desarrollo local: base de los links de los mails cuando el request no
# trae subdominio. Default http://localhost:5175 (ver services/turnosService.js).
# PUBLIC_BASE_URL=http://localhost:5175

# Secreto para el endpoint de ops POST /api/plataforma/cache/invalidate.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Fail-safe: si no está seteado, el endpoint responde 503 (deshabilitado).
PLATFORM_ADMIN_KEY=[TU-SECRETO-PLATAFORMA-64-HEX]

NODE_ENV=development

# Sentry (errores de la app y cortes del rate limiter). Sin esta variable Sentry queda
# apagado y el backend funciona igual. En local va el DSN del proyecto de PRUEBA de
# Sentry, nunca el de producción.
SENTRY_DSN=[TU-SENTRY-DSN]

# Formulario de alta de clientes: a esta dirección llega el aviso de cada solicitud
# enviada (referencia, negocio e id; sin más datos del cliente). Sin esta variable el
# envío funciona igual y solo loguea un warn. En local, tu mail para probar el flujo.
ALTA_AVISO_EMAIL=[TU-MAIL]
