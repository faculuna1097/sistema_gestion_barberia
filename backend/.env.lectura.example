# Credenciales del rol de SOLO LECTURA de la base (resguardo_lectura).
# Las usan backend/scripts/consultar.js y los scripts de la skill alta-cliente,
# a través de backend/scripts/conexionLectura.js.
#
# Copiá este archivo como backend/.env.lectura (está en el .gitignore) y completalo.
# Solo van el usuario y la contraseña: host, puerto y base salen de backend/.env.

# Usuario del Session Pooler: el rol, un punto y el project ref de Supabase
# (el mismo ref que va en el DB_USER del .env, después de "postgres.").
# Tiene que empezar con "resguardo_lectura.": si no, los scripts no se conectan.
DB_USER=resguardo_lectura.[PROJECT-REF]

# La contraseña que se le puso al rol al crearlo en el SQL Editor.
DB_PASSWORD=[CONTRASEÑA-DEL-ROL-DE-LECTURA]
