# Dependencias
node_modules/
**/node_modules/

# Archivos de build
dist/
build/

# Variables de entorno (seguridad)
.env
.env.local
.env.production
backend/.env
frontend/.env

# Logs
*.log
npm-debug.log*

# Sistema operativo
.DS_Store
Thumbs.db

# Scripts operativos one-off (no se commitean)
backend/scripts/

# Configuración de Claude Code
# Se ignora todo .claude/ salvo lo compartido: settings.json (permisos de solo
# lectura para la skill de diagnóstico) y skills/ (salud-prod). Van al repo para
# que la sesión en la nube, que clona GitHub, los tenga. Es .claude/* y no
# .claude/ porque git no deja re-incluir nada dentro de una carpeta ignorada.
# launch.json y settings.local.json siguen ignorados (son locales).
.claude/*
!.claude/settings.json
!.claude/skills/


